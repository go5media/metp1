          "_name": "article13",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article13\" group=\"Article\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen, 'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Content Width\" name=\"contentWidth\" min=\"4\" max=\"12\" step=\"1\" value=\"10\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"color\" title=\"Wrap Bg\" name=\"wrapBgColor\" value=\"#393193\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n           <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"card col-md-12 col-lg-{{contentWidth}}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-box align-left\">\n                        <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .card-box\">\n                            <b>Contact US</b></h4>\n                        <p class=\"mbr-text mbr-fonts-style mt-4\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\"><p><span style=\"font-size: calc(1.14rem + 0.26 * ((100vw - 62rem) / 25));\">1.</span><br></p><p>Police Constable<br>police-constable.request@met.uscn.org.uk<br><br>Police Sergeant<br>police-sergeant.request@met.uscn.org.uk<br><br>Detective Constable<br>detective-constable.request@met.uscn.org.uk<br><br>Detective Sergeant<br>detective-sergeant.request@met.uscn.org.uk<br><br>Detective Inspector<br>detective-inspector.request@met.uscn.org.uk<br><br>Police Community Support Officer (PCSO)<br>pcso.request@met.uscn.org.uk<br><br>Collision Investigator<br>collision-investigator.request@met.uscn.org.uk<br><br>Digital Forensics<br>digital-forensics.request@met.uscn.org.uk<br><br>Police Staff Investigator<br>staff-investigator.request@met.uscn.org.uk<br><br>CCTV / Video Evidence Officer<br>video-evidence.request@met.uscn.org.uk</p><p><span style=\"font-size: calc(1.14rem + 0.26 * ((100vw - 62rem) / 25));\">Tel: 0330 520 4085</span></p><br><p>Data Handling - Data Protection</p><br><p><br>2.&nbsp;<br>For enquires regarding camera hardware we operate (including logs) contact:<br><br>Software Logs<br>met-police.software-logs@ware.uscn.org.uk<br><br>Camera Locations, Manufactures<br>met-police.hardware@ware.uscn.org.uk<br><br>General Information in relation to hard/software&nbsp;<br>hws631448@ware.uscn.org.uk</p><p><span style=\"font-size: calc(1.14rem + 0.26 * ((100vw - 62rem) / 25));\">(HSW-General-Mailbox, Metropolitan-Police)</span></p>Tel: 0330 520 4085<br><br>(met-police.dpo@ware.uscn.org.uk may need to involved when disclosing certain information)<br><br><p><span style=\"font-size: calc(1.14rem + 0.26 * ((100vw - 62rem) / 25));\">HSW - Hard/Soft Ware.</span></p></p>\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn mt-4\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                        <a class=\"btn btn-secondary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                        Start now\n                        </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "vBhmFnN7EU",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "article13-7"
        }
      ]
    }
  }
}